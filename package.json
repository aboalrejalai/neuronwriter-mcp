{
  "name": "neuronwriter-mcp",
  "version": "0.3.0",
  "description": "MCP server for NeuronWriter: API v0.5 tools today, browser-session backend next",
  "type": "module",
  "bin": {
    "neuronwriter-mcp": "build/index.js"
  },
  "files": [
    "build",
    "skills"
  ],
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "scripts": {
    "build": "tsc && node -e \"import('fs').then(fs => fs.chmodSync('build/index.js', 0o755))\"",
    "dev": "tsx src/index.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "login": "node build/index.js login",
    "status": "node build/index.js status",
    "inspector": "npx @modelcontextprotocol/inspector node build/index.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "axios": "^1.6.0",
    "playwright": "^1.64.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.4"
  }
}
